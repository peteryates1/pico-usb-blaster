.program blaster_jtag
.side_set 1

; 2-instruction JTAG shift: 4 SM-clock cycles per bit, 50% duty cycle.
; Autopull/autopush at 8 bits, right-shift (LSB-first).
; Stalls on empty TX FIFO with TCK low (safe idle).
; TCK = sys_clk / (BLASTER_JTAG_CLKDIV * 4). At 120 MHz sys:
;   clkdiv 2 -> 15 MHz TCK, clkdiv 8 -> 3.75 MHz, clkdiv 16 -> 1.875 MHz.
; Set to 6 MHz, matching a genuine Altera USB-Blaster — which is also what
; Quartus reports this cable as (jtagconfig --getparam JtagClock returns 6M and
; is read-only, so the host cannot slow a clone down; only firmware can).
;
; RESOLVED 2026-08-27: this cable now configures FPGAs successfully. A 4.88 MB
; .sof was written to an EP4CGX150 in 43 s at 6 MHz, Quartus reporting
; "Configuration succeeded". IDCODE reads are stable on both an EP4CGX150
; (0x028040DD) and a QMTECH 10CL025 (0x020F30DD).
;
; The earlier failures were the flying leads, as suspected — specifically the
; lack of level shifting. The fix is the pico-usb-debug-jtag carrier
; (../../pico-usb-debug-jtag): an SN74LVC1T45 per signal referenced to the
; target's own VTREF, with 33R source termination. 6 MHz survives even a
; breadboarded version of that; the clock was never the problem.

.wrap_target
    out pins, 1     side 0 [1]  ; TDI output, TCK low  (2 cycles)
    in pins, 1      side 1 [1]  ; Read TDO,   TCK high (2 cycles)
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

static inline void blaster_jtag_program_init(PIO pio, uint sm, uint offset,
                                             uint tdi_pin, uint tdo_pin, uint tck_pin)
{
    // Configure TCK as side-set, TDI as OUT, TDO as IN
    pio_gpio_init(pio, tck_pin);
    pio_gpio_init(pio, tdi_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, tck_pin, 1, true);   // TCK output
    pio_sm_set_consecutive_pindirs(pio, sm, tdi_pin, 1, true);   // TDI output

    pio_sm_config c = blaster_jtag_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, tck_pin);
    sm_config_set_out_pins(&c, tdi_pin, 1);
    sm_config_set_in_pins(&c, tdo_pin);

    // LSB-first, autopull/autopush at 8 bits
    sm_config_set_out_shift(&c, true, true, 8);   // right-shift, autopull
    sm_config_set_in_shift(&c, true, true, 8);    // right-shift, autopush

    // See the header comment: TCK = sys_clk / (CLKDIV * 4).
#ifndef BLASTER_JTAG_CLKDIV
#define BLASTER_JTAG_CLKDIV 5.0f    /* 6 MHz TCK — matches a genuine USB-Blaster */
#endif
/* Override from CMake: -DJTAG_CLKDIV=40 gives 750 kHz, for breadboard/flywire
 * bring-up where 6 MHz will not survive the wiring. */
    sm_config_set_clkdiv(&c, BLASTER_JTAG_CLKDIV);

    // Bypass input synchronizer on TDO for minimum latency
    hw_set_bits(&pio->input_sync_bypass, 1u << tdo_pin);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
